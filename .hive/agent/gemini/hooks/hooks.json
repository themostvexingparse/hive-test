{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "hive hook BeforeTool --vendor gemini"
          }
        ],
        "matcher": "*"
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "hive hook AfterTool --vendor gemini"
          }
        ],
        "matcher": "*"
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "hive hook BeforeAgent --vendor gemini"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "hive hook AfterAgent --vendor gemini"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "hive hook SessionStart --vendor gemini"
          }
        ]
      }
    ]
  }
}
